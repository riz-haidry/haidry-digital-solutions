PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/haidry-digital-solutions
FRONTEND_URL=http://localhost:5173
# Generate a private random value of at least 32 characters.
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters
# On Render, set the same ADMIN_* values. The API upserts this admin on every boot.
